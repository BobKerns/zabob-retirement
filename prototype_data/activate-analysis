# Source this from bash or zsh:  source path/to/data_repo/activate-analysis
# See ADR-004 §4 for full semantics.

if [ -n "${BASH_SOURCE-}" ]; then
    _ANALYSIS_SELF="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION-}" ]; then
    # shellcheck disable=SC2296
    _ANALYSIS_SELF="${(%):-%x}"
else
    echo "activate-analysis: source from bash or zsh" >&2
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1
fi

_analysis_fail() {
    echo "activate-analysis: $*" >&2
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1
}

_analysis_validate_repo_dir() {
    [ -n "$1" ] || return 1
    [ -d "$1" ] || return 1
    [ -f "$1/pyproject.toml" ] || return 1
    [ -f "$1/src/zabob/retirement/cli.py" ] || return 1
    [ -f "$1/src/zabob/retirement/amazon/cli.py" ] || return 1
    [ -f "$1/src/zabob/retirement/sim/cli.py" ] || return 1
    return 0
}

_analysis_enable_completion() {
    # Click completion env var differs by command name.
    _analysis_shell_mode="$1"
    eval "$(_ANALYSIS_COMPLETE=${_analysis_shell_mode} analysis)" 2>/dev/null || true
    eval "$(_AMAZON_COMPLETE=${_analysis_shell_mode} amazon)" 2>/dev/null || true
    eval "$(_SIM_COMPLETE=${_analysis_shell_mode} sim)" 2>/dev/null || true
    unset _analysis_shell_mode
}

export ANALYSIS_DATA_DIR
ANALYSIS_DATA_DIR="$(cd "$(dirname "$_ANALYSIS_SELF")" && pwd)"
export ANALYSIS_DATA_REPO_NAME="${ANALYSIS_DATA_REPO_NAME:-$(basename "$ANALYSIS_DATA_DIR")}"

_ANALYSIS_POINTER_FILE="$ANALYSIS_DATA_DIR/.analysis"
_ANALYSIS_REMEMBERED=""
if [ -f "$_ANALYSIS_POINTER_FILE" ]; then
    IFS= read -r _ANALYSIS_REMEMBERED < "$_ANALYSIS_POINTER_FILE"
fi

# The code checkout this was sourced through (<checkout>/data/private/sim)
# comes first (#654): several worktrees can link one data repo, and each
# then gets its own code, whichever was activated last or made the data
# repo. Then ANALYSIS_REPO_DIR, then the checkout remembered in .analysis.
# The path is taken as it was typed, not from ANALYSIS_DATA_DIR: where the
# shell follows links on cd (zsh's CHASE_LINKS, bash's set -P) that one is
# the data repo's own folder, with no checkout around it.
_ANALYSIS_REPO_CANDIDATE=""
_ANALYSIS_THROUGH=""
_ANALYSIS_TYPED="$(dirname "$_ANALYSIS_SELF")"
case "$_ANALYSIS_TYPED" in
    /*) ;;
    *) _ANALYSIS_TYPED="$PWD/$_ANALYSIS_TYPED" ;;
esac
for _analysis_spelled in "$_ANALYSIS_TYPED" "$ANALYSIS_DATA_DIR"; do
    case "$_analysis_spelled" in
        */data/private/sim)
            if _analysis_validate_repo_dir "${_analysis_spelled%/data/private/sim}"; then
                _ANALYSIS_THROUGH="$(cd "${_analysis_spelled%/data/private/sim}" && pwd)"
                _ANALYSIS_REPO_CANDIDATE="$_ANALYSIS_THROUGH"
                break
            fi
            ;;
    esac
done
unset _analysis_spelled _ANALYSIS_TYPED
if [ -z "$_ANALYSIS_REPO_CANDIDATE" ]; then
    _ANALYSIS_REPO_CANDIDATE="${ANALYSIS_REPO_DIR-}"
fi
if [ -z "$_ANALYSIS_REPO_CANDIDATE" ]; then
    _ANALYSIS_REPO_CANDIDATE="$_ANALYSIS_REMEMBERED"
fi

# Nothing names the program (a data repo cloned onto a new machine): the
# sim on PATH, if any, is it. Beside it, a checkout's .venv/bin or an
# installed program's own folder (#662); uv links the latter into ~/.local/bin.
if [ -z "$_ANALYSIS_REPO_CANDIDATE" ] && _analysis_sim="$(command -v sim 2>/dev/null)"; then
    if [ -L "$_analysis_sim" ]; then
        _analysis_sim="$(readlink "$_analysis_sim")"
    fi
    _analysis_sim="$(cd "$(dirname "$_analysis_sim")" 2>/dev/null && pwd)"
    if _analysis_validate_repo_dir "${_analysis_sim%/.venv/bin}"; then
        _ANALYSIS_REPO_CANDIDATE="${_analysis_sim%/.venv/bin}"
    elif [ -x "$_analysis_sim/python" ]; then
        _ANALYSIS_REPO_CANDIDATE="installed:$_analysis_sim"
    fi
fi
unset _analysis_sim

# An installed program (`uv tool install zabob-retirement`, #662) is named
# installed:<its folder>: it has no checkout and no .venv to activate.
_ANALYSIS_INSTALLED=""
case "$_ANALYSIS_REPO_CANDIDATE" in
    installed:*)
        _ANALYSIS_INSTALLED="${_ANALYSIS_REPO_CANDIDATE#installed:}"
        [ -x "$_ANALYSIS_INSTALLED/sim" ] || \
            _analysis_fail "no sim in $_ANALYSIS_INSTALLED: reinstall with 'uv tool install zabob-retirement', or remove $_ANALYSIS_POINTER_FILE"
        ;;
esac

if [ -z "$_ANALYSIS_INSTALLED" ] && ! _analysis_validate_repo_dir "$_ANALYSIS_REPO_CANDIDATE"; then
    echo "activate-analysis: analysis program repo path not configured." >&2
    printf "Enter ANALYSIS_REPO_DIR: " >&2
    read -r _ANALYSIS_REPO_CANDIDATE
fi

if [ -z "$_ANALYSIS_INSTALLED" ] && ! _analysis_validate_repo_dir "$_ANALYSIS_REPO_CANDIDATE"; then
    _analysis_fail "invalid repo path: '$_ANALYSIS_REPO_CANDIDATE' (expected pyproject.toml and src/zabob/retirement/*/cli.py)"
fi

export ANALYSIS_REPO_DIR="$_ANALYSIS_REPO_CANDIDATE"

# The two are compared as the folders they are, not as they are spelled:
# `sim init` writes the path it finds itself at, this the one it was sourced
# through, and under a linked folder those differ for one checkout.
_analysis_same_dir() {
    [ "$1" = "$2" ] && return 0
    [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$(cd "$2" 2>/dev/null && pwd -P)" ]
}
# .analysis names the one checkout the data repo is paired with: the
# builder's hooks run that checkout's sim. Another worktree sourcing this
# through its own data/private uses its own code and leaves the pair alone.
# The pair is written when .analysis names no checkout, or when this is
# sourced by the data repo's own path with another checkout named
# (ANALYSIS_REPO_DIR, or typed just now).
_ANALYSIS_KEEP_POINTER=""
if [ -n "$_ANALYSIS_INSTALLED" ] && [ "$_ANALYSIS_REMEMBERED" = "$ANALYSIS_REPO_DIR" ]; then
    _ANALYSIS_KEEP_POINTER=1
elif [ -n "$_ANALYSIS_REMEMBERED" ] && [ -z "$_ANALYSIS_INSTALLED" ] && ! _analysis_same_dir "$_ANALYSIS_REMEMBERED" "$ANALYSIS_REPO_DIR"; then
    # Said, since the wrong checkout's code is otherwise found out much
    # later, by what it lacks.
    if [ -n "$_ANALYSIS_THROUGH" ] && _analysis_validate_repo_dir "$_ANALYSIS_REMEMBERED"; then
        _ANALYSIS_KEEP_POINTER=1
        echo "activate-analysis: using the code in $ANALYSIS_REPO_DIR; the data repo stays paired with $_ANALYSIS_REMEMBERED (its background builds run there)" >&2
    else
        echo "activate-analysis: using the code in $ANALYSIS_REPO_DIR (it was $_ANALYSIS_REMEMBERED)" >&2
    fi
elif [ -n "$_ANALYSIS_REMEMBERED" ] && [ -z "$_ANALYSIS_INSTALLED" ]; then
    # The same checkout, however it is spelled: nothing to rewrite.
    _ANALYSIS_KEEP_POINTER=1
fi
unset -f _analysis_same_dir
# `sim init` copied this file from the code's templates/, where it changes.
# Which of the two is the newer isn't known here: with several checkouts on
# one data repo, an older one's would undo what a newer one brought.
if [ -f "$ANALYSIS_REPO_DIR/templates/activate-analysis" ] && \
    ! cmp -s "$_ANALYSIS_SELF" "$ANALYSIS_REPO_DIR/templates/activate-analysis"; then
    echo "activate-analysis: this copy differs from $ANALYSIS_REPO_DIR/templates/activate-analysis." >&2
    echo "  If that checkout has the newest code of those using this data repo, take its copy:" >&2
    echo "  cp $ANALYSIS_REPO_DIR/templates/activate-analysis $ANALYSIS_DATA_DIR/" >&2
fi

# Persist pointer and ensure it is ignored by the data repo.
if [ -z "$_ANALYSIS_KEEP_POINTER" ]; then
    printf '%s\n' "$ANALYSIS_REPO_DIR" > "$_ANALYSIS_POINTER_FILE" || \
        _analysis_fail "unable to write $_ANALYSIS_POINTER_FILE"
fi
unset _ANALYSIS_KEEP_POINTER _ANALYSIS_THROUGH

# A line that comments the name out (`# .retention.yaml`) or negates it
# (`!.retention.yaml`) records a choice to commit that file, such as a shared
# retention policy, so it counts as present and isn't added back (#712).
for _analysis_ignored in .analysis .current_scenario .analysis_user .retention.yaml; do
    if [ ! -f "$ANALYSIS_DATA_DIR/.gitignore" ]; then
        printf '%s\n' "$_analysis_ignored" > "$ANALYSIS_DATA_DIR/.gitignore" || \
            _analysis_fail "unable to write $ANALYSIS_DATA_DIR/.gitignore"
    elif ! grep -qE "^(#[[:space:]]*|!)?/?$(printf '%s' "$_analysis_ignored" | sed 's/\./\\./g')\$" \
            "$ANALYSIS_DATA_DIR/.gitignore"; then
        printf '%s\n' "$_analysis_ignored" >> "$ANALYSIS_DATA_DIR/.gitignore" || \
            _analysis_fail "unable to update $ANALYSIS_DATA_DIR/.gitignore"
    fi
done
unset _analysis_ignored

if [ -n "$_ANALYSIS_INSTALLED" ]; then
    # Its commands are already on PATH (~/.local/bin), but `python` there
    # isn't its Python: put its own folder first, as activating a venv would.
    _ANALYSIS_PYTHON="$_ANALYSIS_INSTALLED/python"
    case ":$PATH:" in
        *":$_ANALYSIS_INSTALLED:"*) ;;
        *)
            _ANALYSIS_OLD_PATH="$PATH"
            PATH="$_ANALYSIS_INSTALLED:$PATH"
            export PATH
            ;;
    esac
else
    if [ ! -f "$ANALYSIS_REPO_DIR/.venv/bin/activate" ]; then
        command -v uv >/dev/null 2>&1 || _analysis_fail "uv not found; install uv to bootstrap .venv"
        (
            cd "$ANALYSIS_REPO_DIR" || exit 1
            uv sync --group dev
        ) || _analysis_fail "uv sync failed while creating $ANALYSIS_REPO_DIR/.venv"
    fi

    # Activate the project virtual environment.
    # shellcheck disable=SC1090,SC1091
    . "$ANALYSIS_REPO_DIR/.venv/bin/activate" || _analysis_fail "failed to activate .venv"
    _ANALYSIS_PYTHON=python
fi

if [ -n "${ZSH_VERSION-}" ]; then
    _analysis_enable_completion "zsh_source"
elif [ -n "${BASH_VERSION-}" ]; then
    _analysis_enable_completion "bash_source"
fi

# Prompt segment, in the style of oh-my-zsh's git_prompt_info: PS1 holds a
# literal $(analysis_prompt_info) that is expanded at each prompt, so it is
# added only once no matter how many times this script is sourced. It reads
# who you are and your current scenario afresh each time, from your own
# settings (#773): `sim login` and any sim command naming a scenario change
# them. With no current scenario the segment leaves it out (#214).
analysis_prompt_info() {
    [ -n "${ANALYSIS_DATA_REPO_NAME-}" ] || return 0
    case "${XDG_CONFIG_HOME-}" in
        /*) _analysis_cfg="$XDG_CONFIG_HOME/zabob-retirement" ;;
        *) _analysis_cfg="$HOME/.config/zabob-retirement" ;;
    esac
    _analysis_user="${ANALYSIS_USER-}"
    if [ -z "$_analysis_user" ] && [ -r "$_analysis_cfg/user" ]; then
        IFS= read -r _analysis_user < "$_analysis_cfg/user"
    fi
    _analysis_scenario=""
    _analysis_found=""
    # zsh's NOMATCH makes an unmatched glob an error: no repos/ yet, no loop.
    [ -n "${ZSH_VERSION-}" ] && setopt localoptions nullglob
    [ -d "$_analysis_cfg/repos" ] && for _analysis_loc in "$_analysis_cfg"/repos/*/location; do
        [ -r "$_analysis_loc" ] || continue
        IFS= read -r _analysis_where < "$_analysis_loc"
        if [ "$_analysis_where" = "$ANALYSIS_DATA_DIR" ] || \
            [ "$_analysis_where" = "$(cd "$ANALYSIS_DATA_DIR" 2>/dev/null && pwd -P)" ]; then
            _analysis_found="${_analysis_loc%/location}/scenario"
            break
        fi
    done
    if [ -n "$_analysis_found" ] && [ -f "$_analysis_found" ]; then
        IFS= read -r _analysis_scenario < "$_analysis_found"
    elif [ -r "${ANALYSIS_DATA_DIR-}/.current_scenario" ]; then
        IFS= read -r _analysis_scenario < "$ANALYSIS_DATA_DIR/.current_scenario"
    fi
    printf '[analysis:%s' "$ANALYSIS_DATA_REPO_NAME"
    [ -n "$_analysis_user" ] && printf ':%s' "$_analysis_user"
    [ -n "$_analysis_scenario" ] && printf ':%s' "$_analysis_scenario"
    printf '] '
    unset _analysis_cfg _analysis_user _analysis_found _analysis_loc _analysis_where
    unset _analysis_scenario
}

if [ -n "${ZSH_VERSION-}" ]; then
    # Only the first sourcing (before any matching deactivate-analysis)
    # records the pre-activation state; re-sourcing while already active
    # must not overwrite it with "already set" from our own setopt below,
    # or deactivation would leak prompt_subst into the user's shell.
    if [ -z "${_ANALYSIS_PROMPT_SUBST_WAS_SET+x}" ]; then
        if [[ -o prompt_subst ]]; then
            _ANALYSIS_PROMPT_SUBST_WAS_SET=1
        else
            _ANALYSIS_PROMPT_SUBST_WAS_SET=0
        fi
    fi
    setopt prompt_subst
fi
# shellcheck disable=SC2016
case "${PS1-}" in
    *'$(analysis_prompt_info)'*) ;;
    *) PS1='$(analysis_prompt_info)'"${PS1-}" ;;
esac

deactivate-analysis() {
    # shellcheck disable=SC2016
    PS1="${PS1//'$(analysis_prompt_info)'/}"
    if typeset -f deactivate >/dev/null 2>&1; then
        deactivate
    fi
    if [ -n "${_ANALYSIS_OLD_PATH+x}" ]; then
        PATH="$_ANALYSIS_OLD_PATH"
        export PATH
    fi
    if [ -n "${ZSH_VERSION-}" ] && [ "${_ANALYSIS_PROMPT_SUBST_WAS_SET-0}" = "0" ]; then
        unsetopt prompt_subst
    fi
    unset ANALYSIS_DATA_DIR ANALYSIS_DATA_REPO_NAME ANALYSIS_REPO_DIR
    unset _ANALYSIS_SELF
    unset _ANALYSIS_POINTER_FILE _ANALYSIS_REPO_CANDIDATE _ANALYSIS_REMEMBERED
    unset _ANALYSIS_PROMPT_SUBST_WAS_SET _ANALYSIS_INSTALLED _ANALYSIS_PYTHON _ANALYSIS_OLD_PATH
    unset -f _analysis_fail _analysis_validate_repo_dir _analysis_enable_completion
    unset -f analysis_prompt_info deactivate-analysis
}
